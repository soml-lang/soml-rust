root = true

[*]
indent_style = tab
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.yml]
indent_style = space
indent_size = 2

# The conformance cases test exact bytes, including trailing whitespace, a missing final line feed, and invalid encodings, so an editor must not change them.
[tests/conformance/**]
charset = unset
end_of_line = unset
indent_style = unset
trim_trailing_whitespace = false
insert_final_newline = false
